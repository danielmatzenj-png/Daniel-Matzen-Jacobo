# Wallet en Polygon que tiene USDC y está aprobada en Polymarket CLOB.
# NUNCA commitees el .env real.
PRIVATE_KEY=0xPON_AQUI_TU_LLAVE_PRIVADA
POLY_FUNDER=0xDIRECCION_DE_LA_WALLET_FUNDER

# Credenciales API CLOB (se obtienen con createOrDeriveApiKey la primera vez).
# Si las dejas vacías, el ejecutor las generará y las imprimirá en el log al
# arrancar; cópialas aquí después.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Servidor HTTP local donde escucha el ejecutor (lo llama el bot Python).
PORT=8787

# Polymarket CLOB host
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
